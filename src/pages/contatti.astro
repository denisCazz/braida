---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contatti | Beppe Braida" description="Contatta Beppe Braida per spettacoli, eventi e collaborazioni.">

  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container page-hero-content">
      <span class="badge">&#9993; Contatti</span>
      <h1 class="page-title">Contattaci</h1>
      <p class="page-subtitle">Per informazioni su spettacoli, eventi e collaborazioni</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Parliamo!</h2>
        <p>
          Hai bisogno di Beppe Braida per il tuo evento? Vuoi informazioni sullo spettacolo
          "PIANO B" o sulla presentazione eventi? Compila il modulo e ti risponderemo
          il prima possibile!
        </p>

        <div class="info-cards">
          <div class="info-card">
            <div class="info-icon">&#128233;</div>
            <div>
              <h4>Email</h4>
              <p>Scrivici per qualsiasi richiesta</p>
            </div>
          </div>
          <div class="info-card">
            <div class="info-icon">&#128241;</div>
            <div>
              <h4>Social</h4>
              <p>Seguici su Facebook e Instagram</p>
            </div>
          </div>
          <div class="info-card">
            <div class="info-icon">&#127917;</div>
            <div>
              <h4>Booking</h4>
              <p>Per prenotazioni spettacoli ed eventi</p>
            </div>
          </div>
        </div>

        <div class="social-row">
          <a href="https://www.facebook.com/officialbeppebraida/" target="_blank" rel="noopener noreferrer" class="social-btn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Facebook
          </a>
          <a href="https://www.instagram.com/beppebraida/" target="_blank" rel="noopener noreferrer" class="social-btn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            Instagram
          </a>
          <a href="https://www.linkedin.com/in/beppe-braida-37076987/" target="_blank" rel="noopener noreferrer" class="social-btn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <div class="contact-form-wrap">
        <form class="contact-form" id="contact-form">
          <div class="form-group">
            <label for="name">Nome *</label>
            <input type="text" id="name" name="name" required placeholder="Il tuo nome" />
          </div>
          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required placeholder="La tua email" />
          </div>
          <div class="form-group">
            <label for="phone">Telefono</label>
            <input type="tel" id="phone" name="phone" placeholder="Il tuo numero" />
          </div>
          <div class="form-group">
            <label for="subject">Oggetto *</label>
            <select id="subject" name="subject" required>
              <option value="">Seleziona...</option>
              <option value="spettacolo">Spettacolo "PIANO B"</option>
              <option value="eventi">Presentazione Eventi</option>
              <option value="collaborazione">Collaborazione</option>
              <option value="altro">Altro</option>
            </select>
          </div>
          <div class="form-group full-width">
            <label for="message">Messaggio *</label>
            <textarea id="message" name="message" rows="5" required placeholder="Raccontaci di cosa hai bisogno..."></textarea>
          </div>
          <div class="form-group full-width">
            <button type="submit" class="btn btn-primary btn-submit">
              Invia Messaggio &rarr;
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    position: relative;
    padding: 10rem 2rem 4rem;
    text-align: center;
    overflow: hidden;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 40% 50%, rgba(230, 57, 70, 0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 30%, rgba(29, 53, 87, 0.3) 0%, transparent 50%),
      var(--color-darker);
  }

  .page-hero-content { position: relative; z-index: 1; }

  .page-title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    animation: fadeInUp 0.8s ease both;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    animation: fadeInUp 0.8s ease both;
    animation-delay: 0.3s;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(230, 57, 70, 0.15);
    color: var(--color-primary);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s ease both;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info h2 {
    font-size: 2.5rem;
    color: var(--color-text-strong);
    margin-bottom: 1rem;
  }

  .contact-info > p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .info-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .info-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 14px;
    transition: all var(--transition);
  }

  .info-card:hover {
    background: var(--color-card-hover);
    border-color: rgba(230, 57, 70, 0.15);
  }

  .info-icon {
    font-size: 1.5rem;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(230, 57, 70, 0.1);
    border-radius: 12px;
    flex-shrink: 0;
  }

  .info-card h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-strong);
    margin-bottom: 0.2rem;
  }

  .info-card p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .social-row {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: var(--color-card-bg);
    border-radius: 10px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    transition: all var(--transition);
  }

  .social-btn:hover {
    background: rgba(230, 57, 70, 0.15);
    color: var(--color-primary);
  }

  /* ===== FORM ===== */
  .contact-form-wrap {
    padding: 2.5rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 24px;
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.85rem 1rem;
    background: var(--color-input-bg);
    border: 1px solid var(--color-input-border);
    border-radius: 12px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: all var(--transition);
    outline: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    background: var(--color-input-focus-bg);
    box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.15);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-placeholder);
  }

  .form-group select {
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='white' viewBox='0 0 16 16'%3E%3Cpath d='M8 11L3 6h10l-5 5z'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
  }

  .form-group select option {
    background: var(--color-dark);
    color: var(--color-text);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-submit {
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    padding: 1rem;
  }

  @media (max-width: 1024px) {
    .contact-grid { gap: 2.5rem; }
  }

  @media (max-width: 768px) {
    .page-hero { padding: 8rem 1.5rem 3rem; }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .contact-form {
      grid-template-columns: 1fr;
    }
    .contact-form-wrap { padding: 1.5rem; }
    .form-group.full-width {
      grid-column: auto;
    }
    .contact-info h2 { font-size: 2rem; }
    .social-row { justify-content: center; }
    .info-cards { gap: 0.8rem; }
  }

  @media (max-width: 480px) {
    .page-hero { padding: 7rem 1rem 2rem; }
    .contact-form-wrap { padding: 1.2rem; }
    .contact-info h2 { font-size: 1.6rem; }
    .social-btn { flex: 1; justify-content: center; min-width: 0; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('.btn-submit');
    if (btn) {
      btn.textContent = 'Messaggio inviato! ✓';
      btn.setAttribute('disabled', 'true');
      (btn as HTMLElement).style.opacity = '0.7';
    }
  });
</script>
