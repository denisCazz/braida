---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Video | Beppe Braida" description="Video e clip di Beppe Braida - Spettacoli, interviste e momenti divertenti.">

  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container page-hero-content">
      <span class="badge">&#127916; Video</span>
      <h1 class="page-title">Video</h1>
      <p class="page-subtitle">Guarda i migliori momenti di Beppe Braida in azione</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="video-intro">
        <p>Scopri i video degli spettacoli, delle apparizioni televisive e dei momenti più divertenti!</p>
      </div>

      <div class="social-videos">
        <div class="social-card">
          <div class="social-card-icon">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <h3>YouTube</h3>
          <p>Segui il canale YouTube per clip e spettacoli completi</p>
        </div>
        <div class="social-card">
          <div class="social-card-icon" style="color: #E4405F;">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </div>
          <h3>Instagram Reels</h3>
          <p>Segui @beppebraida per reel divertenti e dietro le quinte</p>
          <a href="https://www.instagram.com/beppebraida/" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="margin-top: 1rem;">Vai su Instagram &rarr;</a>
        </div>
        <div class="social-card">
          <div class="social-card-icon" style="color: #1877F2;">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <h3>Facebook</h3>
          <p>Video completi e live sulla pagina ufficiale Facebook</p>
          <a href="https://www.facebook.com/officialbeppebraida/" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="margin-top: 1rem;">Vai su Facebook &rarr;</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    position: relative;
    padding: 10rem 2rem 4rem;
    text-align: center;
    overflow: hidden;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(29, 53, 87, 0.3) 0%, transparent 60%),
      var(--color-darker);
  }

  .page-hero-content { position: relative; z-index: 1; }

  .page-title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    animation: fadeInUp 0.8s ease both;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    animation: fadeInUp 0.8s ease both;
    animation-delay: 0.3s;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(230, 57, 70, 0.15);
    color: var(--color-primary);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s ease both;
  }

  .video-intro {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .video-intro p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .social-videos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .social-card {
    padding: 2.5rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 20px;
    text-align: center;
    transition: all var(--transition);
  }

  .social-card:hover {
    background: var(--color-card-hover);
    transform: translateY(-6px);
    box-shadow: 0 10px 40px var(--shadow-color);
  }

  .social-card-icon {
    color: #FF0000;
    margin-bottom: 1.5rem;
  }

  .social-card h3 {
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text-strong);
    margin-bottom: 0.5rem;
  }

  .social-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 8rem 1.5rem 3rem; }
    .social-videos { grid-template-columns: 1fr; gap: 1.5rem; }
    .social-card { padding: 2rem 1.5rem; }
    .social-card-icon svg { width: 36px; height: 36px; }
  }

  @media (max-width: 1024px) and (min-width: 769px) {
    .social-videos { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .page-hero { padding: 7rem 1rem 2rem; }
    .social-card h3 { font-size: 1.1rem; }
    .video-intro p { font-size: 0.95rem; }
  }
</style>
